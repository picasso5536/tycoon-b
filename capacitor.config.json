{
  "appId": "io.github.picasso5536.tycoonb",
  "appName": "붕어빵 타이쿤",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d1322"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d1322"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0d1322",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false,
      "launchShowDuration": 3000
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1322",
      "overlaysWebView": false
    }
  }
}
